---
import { demoReviews, demoReviewsUrl, reviewUrl, summary } from '../data/reviews';

const text = {
  heading: 'What demo players say',
  summary: `${summary.positive} of ${summary.total} Steam reviews of the demo are positive (${summary.asOf}).`,
  all: 'Read all demo reviews on Steam',
  played: (min: number) => `${min} min in the demo`,
  source: 'Steam review',
};
---

<section class="prose" aria-labelledby="demo-reviews">
  <h2 id="demo-reviews">{text.heading}</h2>
  <p>{text.summary}</p>
  <div class="reviews">
    {
      demoReviews.map((r) => (
        <figure class="review">
          <blockquote cite={reviewUrl(r)}>
            <p>“{r.quote}”</p>
          </blockquote>
          <figcaption>
            <a href={reviewUrl(r)} rel="noopener">{text.source}</a> · {text.played(r.playtimeMin)}
          </figcaption>
        </figure>
      ))
    }
  </div>
  <p><a href={demoReviewsUrl} rel="noopener">{text.all}</a></p>
</section>

<style>
  .reviews {
    display: grid;
    gap: 14px;
    margin: 20px 0;
  }

  .review {
    border-left: 2px solid #333;
    padding: 2px 0 2px 16px;
  }

  .review blockquote p {
    color: #e0e0e0;
  }

  .review figcaption {
    margin-top: 6px;
    font-size: 12px;
    letter-spacing: 1px;
    color: #666;
  }
</style>
