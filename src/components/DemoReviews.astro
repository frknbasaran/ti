---
import type { Lang } from '../i18n/ui';
import { demoReviews, demoReviewsUrl, reviewUrl, summary } from '../data/reviews';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const text = {
  en: {
    heading: 'What demo players say',
    summary: `${summary.positive} of ${summary.total} Steam reviews of the demo are positive (${summary.asOf.en}).`,
    all: 'Read all demo reviews on Steam',
    played: (min: number) => `${min} min in the demo`,
    source: 'Steam review',
  },
  tr: {
    heading: 'Demo oyuncuları ne diyor',
    summary: `Demonun Steam'deki ${summary.total} yorumundan ${summary.positive}'i olumlu (${summary.asOf.tr}). Yorumlar oyuncuların yazdığı gibi, İngilizce.`,
    all: "Tüm demo yorumlarını Steam'de oku",
    played: (min: number) => `demoda ${min} dk`,
    source: 'Steam yorumu',
  },
}[lang];
---

<section class="prose" aria-labelledby="demo-reviews">
  <h2 id="demo-reviews">{text.heading}</h2>
  <p>{text.summary}</p>
  <div class="reviews">
    {
      demoReviews.map((r) => (
        <figure class="review">
          <blockquote lang="en" cite={reviewUrl(r)}>
            <p>“{r.quote}”</p>
          </blockquote>
          <figcaption>
            <a href={reviewUrl(r)} rel="noopener">{text.source}</a> · {text.played(r.playtimeMin)}
          </figcaption>
        </figure>
      ))
    }
  </div>
  <p><a href={demoReviewsUrl} rel="noopener">{text.all}</a></p>
</section>

<style>
  .reviews {
    display: grid;
    gap: 14px;
    margin: 20px 0;
  }

  .review {
    border-left: 2px solid #333;
    padding: 2px 0 2px 16px;
  }

  .review blockquote p {
    color: #e0e0e0;
  }

  .review figcaption {
    margin-top: 6px;
    font-size: 12px;
    letter-spacing: 1px;
    color: #666;
  }
</style>
