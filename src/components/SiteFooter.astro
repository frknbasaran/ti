---
import { studio } from '../data/site';
import { game } from '../data/slots-and-skulls';
import { ui } from '../i18n/ui';
import { getPublishedPosts } from '../lib/devlog';

// The devlog link stays hidden until there is at least one published post.
const hasPosts = (await getPublishedPosts()).length > 0;

const current = Astro.url.pathname;
const navItems = [
  { href: `/${game.slug}/`, label: game.name },
  { href: game.wikiPath, label: ui.wiki },
  { href: '/presskit/', label: ui.pressKit },
  ...(hasPosts ? [{ href: '/devlog/', label: ui.devlog }] : []),
];
// The longest link that prefixes the page is current, so Wiki stays marked on
// every wiki page while the game link only marks the game page itself.
const active = navItems
  .filter((item) => current.startsWith(item.href))
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<footer class="footer">
  <nav aria-label={ui.mainNav}>
    {
      navItems.map((item) => (
        <a
          href={item.href}
          aria-current={item.href === active ? (current === item.href ? 'page' : 'true') : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="footer-row">
    <a href={studio.x} rel="noopener">{ui.twitter}</a>
    <a href={`mailto:${studio.email}`}>{ui.email}</a>
  </div>
</footer>
