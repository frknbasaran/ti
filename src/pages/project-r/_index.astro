---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRCover from '../../components/ProjectRCover.astro';
import { game, gameCopy as copy } from '../../data/project-r';
import grayboxImage from '../../assets/project-r/haydarpasa_blockout.png';
import { formatDate, ui } from '../../i18n/ui';
import { getPublishedPosts, postPath } from '../../lib/devlog';

const posts = (await getPublishedPosts()).filter((post) => post.data.game === game.slug);

const text = {
  title: `${game.name} | Trina Interactive`,
  description: `${game.name}: ${copy.tagline}`,
};

const og = await getImage({ src: grayboxImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogImage = { url: og.src, width: 1200, height: 630, alt: copy.imageAlt };
---

<BaseLayout title={text.title} description={text.description} path={`/${game.slug}/`} ogImage={ogImage}>
  <section class="section">
    <h1 class="page-title">{game.name}</h1>
    <p class="game-desc">{copy.tagline}</p>
    <ProjectRCover />
    <h2 class="label">{ui.devlog}</h2>
    {
      posts.length === 0 ? (
        <p class="lead">{ui.noPosts}</p>
      ) : (
        <ul class="posts">
          {posts.map((post) => (
            <li>
              <a href={postPath(post)}>{post.data.title}</a>
              <br />
              <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
              <p class="muted">{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
