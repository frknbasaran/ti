---
import DevlogPost from '../../../views/DevlogPost.astro';
import { getPublishedPosts, postSlug, type DevlogPost as Post } from '../../../lib/devlog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts('tr');
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
---

<DevlogPost post={post} />
