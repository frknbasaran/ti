---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, ui } from '../i18n/ui';
import { getPublishedPosts, postPath } from '../lib/devlog';

const posts = await getPublishedPosts();

const text = {
  title: 'Devlog | Trina Interactive',
  description: 'Development notes from Trina Interactive, the indie studio making Slots & Skulls.',
  heading: 'Devlog',
};

const rssHref = '/devlog/rss.xml';
---

<BaseLayout
  title={text.title}
  description={text.description}
  path="/devlog/"
  noindex={posts.length === 0}
  rss={{ title: text.heading, href: rssHref }}
>
  <section class="section">
    <h1 class="page-title">{text.heading}</h1>
    {
      posts.length === 0 ? (
        <p class="lead">{ui.noPosts}</p>
      ) : (
        <ul class="posts">
          {posts.map((post) => (
            <li>
              <a href={postPath(post)}>{post.data.title}</a>
              <br />
              <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
              <p class="muted">{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
    <p class="muted" style="margin-top: 32px;"><a class="link" href={rssHref}>{ui.rss}</a></p>
  </section>
</BaseLayout>
