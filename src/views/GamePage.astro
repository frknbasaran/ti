---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import GameVideo from '../components/GameVideo.astro';
import DemoReviews from '../components/DemoReviews.astro';
import { game, gameCopy as copy } from '../data/slots-and-skulls';
import { screenshots } from '../data/media';
import { ui } from '../i18n/ui';
import { videoGameLd } from '../lib/jsonld';
import { DEFAULT_OG_IMAGE, studio } from '../data/site';

const path = `/${game.slug}/`;

const text = {
  title: 'Slots & Skulls: a slot machine roguelite | Trina Interactive',
  about: 'About the game',
  details: 'Details',
  developer: 'Developer',
  publisher: 'Publisher',
  release: 'Release date',
  platforms: 'Platforms',
  genre: 'Genre',
  modes: 'Modes',
  controller: 'Controller',
  languages: 'Languages',
  steamFeatures: 'Steam',
  demo: 'Demo',
  demoText: 'Free demo on Steam',
  screenshots: 'Screenshots',
  tags: 'Steam tags',
  requirements: 'System requirements',
  faq: 'FAQ',
  allLanguages: 'Supported languages',
};

// Stable, crawlable image URLs for structured data.
const shotUrls = (
  await Promise.all(screenshots.map((sh) => getImage({ src: sh.src, width: 1280, format: 'jpg' })))
).map((img) => img.src);
---

<BaseLayout
  title={text.title}
  description={copy.metaDescription}
  path={path}
  jsonLd={[
    videoGameLd(path, [DEFAULT_OG_IMAGE.url, ...shotUrls]),
  ]}
>
  <article class="section">
    <h1 class="page-title">{game.name}</h1>
    <p class="lead">{copy.short}</p>

    <GameVideo />

    <div class="cta">
      <a class="button" href={game.steamUrl} rel="noopener">{ui.wishlist}</a>
      <a class="button button--ghost" href={game.demoUrl} rel="noopener">{ui.playDemo}</a>
    </div>

    <DemoReviews />

    <section aria-labelledby="details" class="prose">
      <h2 id="details">{text.details}</h2>
      <div class="game-meta">
        <div><span class="k">{text.developer}</span> <span>{game.developer}</span></div>
        <div><span class="k">{text.publisher}</span> <span>{game.publisher}</span></div>
        <div><span class="k">{text.release}</span> <span>{copy.releaseLabel}</span></div>
        <div>
          <span class="k">{text.platforms}</span>
          <span><a href={game.steamUrl} rel="noopener">Steam</a>: {game.operatingSystems.join(', ')}</span>
        </div>
        <div><span class="k">{text.genre}</span> <span>{game.genres.join(', ')}</span></div>
        <div><span class="k">{text.modes}</span> <span>{copy.facts.modes}</span></div>
        <div><span class="k">{text.controller}</span> <span>{copy.facts.controller}</span></div>
        <div><span class="k">{text.languages}</span> <span>{copy.facts.languages}</span></div>
        <div><span class="k">{text.steamFeatures}</span> <span>{copy.facts.steamFeatures}</span></div>
        <div>
          <span class="k">{text.demo}</span> <a href={game.demoUrl} rel="noopener">{text.demoText}</a>
        </div>
        <div>
          <span class="k">Wiki</span> <a href="/slots-and-skulls/wiki/">Symbols, enemies and rules</a>
        </div>
        <div><span class="k">{ui.pressKit}</span> <a href="/presskit/">{ui.pressKit}</a></div>
        <div><span class="k">X</span> <a href={studio.x} rel="noopener">{studio.xHandle}</a></div>
      </div>
    </section>

    <section class="prose" aria-label={text.about}>
      {
        copy.sections.map((sec) => (
          <>
            <h2>{sec.heading}</h2>
            {sec.paragraphs.map((p) => <p>{p}</p>)}
          </>
        ))
      }
    </section>

    <section class="prose" aria-labelledby="screenshots">
      <h2 id="screenshots">{text.screenshots}</h2>
      <div class="gallery">
        {
          screenshots.map((sh) => (
            <figure>
              <Image src={sh.src} alt={sh.alt} widths={[640, 960]} sizes="(max-width: 640px) 100vw, 296px" loading="lazy" />
            </figure>
          ))
        }
      </div>
    </section>

    <section class="prose" aria-labelledby="tags">
      <h2 id="tags">{text.tags}</h2>
      <ul class="tags">
        {game.steamTags.map((tag) => <li>{tag}</li>)}
      </ul>
    </section>

    <section class="prose" aria-labelledby="requirements">
      <h2 id="requirements">{text.requirements}</h2>
      {
        copy.requirements.map((req) => (
          <>
            <h3>{req.os}</h3>
            <table class="specs">
              <tbody>
                {req.rows.map((r) => (
                  <tr>
                    <th scope="row">{r.label}</th>
                    <td>{r.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        ))
      }
      <h3>{text.allLanguages}</h3>
      <p>{copy.facts.languageList}</p>
    </section>

    <section class="prose" aria-labelledby="faq">
      <h2 id="faq">{text.faq}</h2>
      <dl class="faq">
        {
          copy.faq.map((item) => (
            <>
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </>
          ))
        }
      </dl>
    </section>
  </article>
</BaseLayout>
