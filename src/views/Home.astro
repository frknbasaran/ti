---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameVideo from '../components/GameVideo.astro';
import { studio } from '../data/site';
import { game, gameCopy } from '../data/slots-and-skulls';
import { localizePath, t, type Lang } from '../i18n/ui';
import { organizationLd, websiteLd } from '../lib/jsonld';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const copy = gameCopy[lang];
const gamePath = localizePath(`/${game.slug}/`, lang);

const text = {
  en: {
    title: 'Trina Interactive | Indie game studio behind Slots & Skulls',
    description:
      'Trina Interactive is a small indie game studio making Slots & Skulls, a turn-based roguelite built on a slot machine, for Windows, macOS and Linux on Steam.',
    intro: [
      'Trina Interactive is a small independent game studio.',
      'We are making Slots & Skulls, a turn-based roguelite built on a slot machine, coming to Steam for Windows, macOS and Linux.',
    ],
    contact: 'Say hi:',
    release: 'Release',
  },
  tr: {
    title: 'Trina Interactive | Slots & Skulls’ın bağımsız oyun stüdyosu',
    description:
      'Trina Interactive, slot makinesi üzerine kurulu sıra tabanlı roguelite Slots & Skulls’ı geliştiren küçük bir bağımsız oyun stüdyosu. Windows, macOS, Linux; Steam.',
    intro: [
      'Trina Interactive küçük, bağımsız bir oyun stüdyosu.',
      'Slot makinesi üzerine kurulu sıra tabanlı bir roguelite olan Slots & Skulls’ı geliştiriyoruz; oyun Steam’de Windows, macOS ve Linux için çıkıyor.',
    ],
    contact: 'Bize yazın:',
    release: 'Çıkış',
  },
}[lang];
---

<BaseLayout
  isHome
  lang={lang}
  title={text.title}
  description={text.description}
  path={localizePath('/', lang)}
  alternates={{ en: '/', tr: '/tr/' }}
  jsonLd={[organizationLd(), websiteLd()]}
>
  <section class="section" aria-labelledby="games-label">
    <h2 class="label" id="games-label">{s.games}</h2>

    <article class="game">
      <h3 class="game-title"><a href={gamePath}>{game.name}</a></h3>
      <p class="game-desc">{copy.tagline}</p>

      <GameVideo lang={lang} />

      <div class="game-meta">
        <div>
          <span class="k">{s.platforms}</span>
          <span><a href={game.steamUrl} rel="noopener">Steam</a> (Windows, macOS, Linux)</span>
        </div>
        <div><span class="k">{text.release}</span> <span>{copy.releaseLabel}</span></div>
        <div><span class="k">{s.game}</span> <a href={gamePath}>{s.moreAbout}</a></div>
        <div><span class="k">{s.pressKit}</span> <a href="/presskit/">{s.pressKit}</a></div>
      </div>
    </article>
  </section>

  <section class="section" aria-labelledby="studio-label">
    <h2 class="label" id="studio-label">{s.studio}</h2>
    <div class="prose">
      {text.intro.map((p) => <p>{p}</p>)}
      <p>
        {text.contact} <a href={`mailto:${studio.email}`}>{studio.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>
