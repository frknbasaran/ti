---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameVideo from '../components/GameVideo.astro';
import { studio } from '../data/site';
import { game, gameCopy as copy } from '../data/slots-and-skulls';
import { homeQuote, reviewUrl } from '../data/reviews';
import { ui } from '../i18n/ui';
import { organizationLd, websiteLd } from '../lib/jsonld';

const gamePath = `/${game.slug}/`;

const text = {
  title: 'Trina Interactive | Indie game studio behind Slots & Skulls',
  description:
    'Trina Interactive is a small indie game studio making Slots & Skulls, a turn-based roguelite built on a slot machine, for Windows, macOS and Linux on Steam.',
  intro: [
    'Trina Interactive is a small independent game studio.',
    'We are making Slots & Skulls, a turn-based roguelite built on a slot machine, coming to Steam for Windows, macOS and Linux.',
  ],
  contact: 'Say hi:',
  quoteSource: 'Steam review of the demo',
  release: 'Release',
};
---

<BaseLayout
  isHome
  title={text.title}
  description={text.description}
  path="/"
  jsonLd={[organizationLd(), websiteLd()]}
>
  <section class="section" aria-labelledby="games-label">
    <h2 class="label" id="games-label">{ui.games}</h2>

    <article class="game">
      <h3 class="game-title"><a href={gamePath}>{game.name}</a></h3>
      <p class="game-desc">{copy.tagline}</p>

      <GameVideo />

      <figure class="home-quote">
        <blockquote cite={reviewUrl(homeQuote.review)}>
          <p>“{homeQuote.text}”</p>
        </blockquote>
        <figcaption><a href={reviewUrl(homeQuote.review)} rel="noopener">{text.quoteSource}</a></figcaption>
      </figure>

      <div class="game-meta">
        <div>
          <span class="k">{ui.platforms}</span>
          <span><a href={game.steamUrl} rel="noopener">Steam</a> (Windows, macOS, Linux)</span>
        </div>
        <div><span class="k">{text.release}</span> <span>{copy.releaseLabel}</span></div>
        <div><span class="k">{ui.game}</span> <a href={gamePath}>{ui.moreAbout}</a></div>
        <div><span class="k">{ui.pressKit}</span> <a href="/presskit/">{ui.pressKit}</a></div>
      </div>
    </article>
  </section>

  <section class="section" aria-labelledby="studio-label">
    <h2 class="label" id="studio-label">{ui.studio}</h2>
    <div class="prose">
      {text.intro.map((p) => <p>{p}</p>)}
      <p>
        {text.contact} <a href={`mailto:${studio.email}`}>{studio.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .home-quote {
    border-left: 2px solid #333;
    padding: 2px 0 2px 16px;
    margin-bottom: 28px;
  }

  .home-quote p {
    font-size: 15px;
    line-height: 1.7;
    color: #e0e0e0;
  }

  .home-quote figcaption {
    margin-top: 6px;
    font-size: 12px;
    letter-spacing: 1px;
    color: #666;
  }

  .home-quote a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid #444;
  }
</style>
